# ═══════════════════════════════════════════════════════════════
# MAX — .gitignore
# ═══════════════════════════════════════════════════════════════

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sensitive / Config
config/api_keys.json

# Runtime generated artifacts
generated/


# Memory / Database (user-specific)
memory/long_term.json
memory/max_memory.db*
memory/*.db*
memory/.*
memory/blocked_domains.json
memory/doc_index.json
memory/email_config.json
memory/finance_*.json
memory/ha_config.json
memory/sync_state.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Agents directory (if present)
.agents/
